{
  "heading": "Rebuilt 2026 (Match)",
  "logo": "logo.png",
  "pages": [
    {
      "name": "Setup & Autonomous",
      "widgets": [
        {
          "displayName": "Scouter Name",
          "name": "scouter_name",
          "type": "text",
          "validation": {
            "comparison": "greater",
            "value": 0
          }
        },
        {
          "displayName": "Robot Starting Position",
          "name": "starting_pos",
          "type": "dropdown",
          "options": [
            "Left",
            "Middle",
            "Right"
          ]
        },
        {
          "displayName": "Auto Fuel",
          "name": "auto_fuel",
          "type": "spinbox",
          "min": 0
        },
        {
          "displayName": "Auto Climb",
          "name": "auto_climb",
          "type": "checkbox"
        }
      ]
    },
    {
      "name": "Teleop",
      "widgets": [
        {
          "displayName": "Cycles (pickup + score)",
          "name": "cycles",
          "type": "spinbox",
          "min": 0
        },
        {
          "displayName": "Fuel Scored",
          "name": "fuel_score",
          "type": "spinbox",
          "min": 0
        },
        {
          "displayName": "Passing",
          "name": "passing",
          "type": "checkbox"
        }
      ]
    },
    {
      "name": "Endgame",
      "widgets": [
        {
          "displayName": "Climb",
          "name": "climb",
          "type": "dropdown",
          "options": [
            "L1",
            "L2",
            "L3",
            "None"
          ]
        },
        {
          "displayName": "Zones Played",
          "name": "zone_play",
          "type": "multicheckbox",
          "options": [
            "Blue Alliance",
            "Neutral Zone",
            "Red Alliance"
          ]
        },
        {
          "displayName": "Bump Rank (1=worst, 5=best)",
          "name": "bump_rank",
          "type": "spinbox",
          "min": 1,
          "max": 5
        },
        {
          "displayName": "Drivers Rank (1=worst, 5=best)",
          "name": "drive_rank",
          "type": "spinbox",
          "min": 1,
          "max": 5
        },
        {
          "displayName": "Defense Rank (1=worst, 5=best)",
          "name": "defense_rank",
          "type": "spinbox",
          "min": 1,
          "max": 5
        },
        {
          "displayName": "Breakdown",
          "name": "breakdown",
          "type": "checkbox"
        },
        {
          "displayName": "Additional Comments",
          "name": "comments",
          "type": "textarea"
        }
      ]
    }
  ]
}