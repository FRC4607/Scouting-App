{
  "title": "Match Scout Entry Interface",
  "description": "A single match scouting entry in the database",
  "type": "object",
  "properties": {
    "event_key": {
      "type": "string"
    },
    "match_level": {
      "type": "number",
      "minimum": 0,
      "maximum": 3
    },
    "match_number": {
      "type": "number",
      "minimum": 0
    },
    "is_blue": {
      "type": "boolean"
    },
    "ds_position": {
      "type": "number",
      "minimum": 0,
      "maximum": 3
    },
    "team_number": {
      "type": "number",
      "minimum": 1
    },
    "scouter_name": {
      "type": "string"
    },
    "starting_pos": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "auto_fuel": {
      "type": "integer",
      "minimum": 0
    },
    "auto_climb": {
      "type": "boolean"
    },
    "cycles": {
      "type": "integer",
      "minimum": 0
    },
    "fuel_score": {
      "type": "integer",
      "minimum": 0
    },
    "passing": {
      "type": "boolean"
    },
    "climb": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "zone_play": {
      "type": "integer",
      "minimum": 0
    },
    "bump_rank": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "drive_rank": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "defense_rank": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "breakdown": {
      "type": "boolean"
    },
    "comments": {
      "type": "string"
    },
    "scouted_time": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "event_key",
    "match_level",
    "match_number",
    "is_blue",
    "ds_position",
    "team_number",
    "scouter_name",
    "starting_pos",
    "auto_fuel",
    "auto_climb",
    "cycles",
    "fuel_score",
    "passing",
    "climb",
    "zone_play",
    "bump_rank",
    "drive_rank",
    "defense_rank",
    "breakdown",
    "comments",
    "scouted_time"
  ]
}