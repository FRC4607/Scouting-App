{
  "title": "Match Scout Entry Interface",
  "description": "A single match scouting entry in the database",
  "type": "object",
  "properties": {
    "event_key": {
      "type": "string"
    },
    "match_level": {
      "type": "number",
      "minimum": 0,
      "maximum": 3
    },
    "match_number": {
      "type": "number",
      "minimum": 0
    },
    "is_blue": {
      "type": "boolean"
    },
    "ds_position": {
      "type": "number",
      "minimum": 0,
      "maximum": 3
    },
    "team_number": {
      "type": "number",
      "minimum": 1
    },
    "scouter_name": {
      "type": "string"
    },
    "auto_cycles": {
      "type": "integer",
      "minimum": 0
    },
    "teleop_cycles": {
      "type": "integer",
      "minimum": 0
    },
    "driver_rank": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "defense_rank": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "comments": {
      "type": "string"
    },
    "scouted_time": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "event_key",
    "match_level",
    "match_number",
    "is_blue",
    "ds_position",
    "team_number",
    "scouter_name",
    "auto_cycles",
    "teleop_cycles",
    "driver_rank",
    "defense_rank",
    "comments",
    "scouted_time"
  ]
}