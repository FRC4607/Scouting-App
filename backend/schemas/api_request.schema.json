{
  "title": "Scouting Entry Upload Schema",
  "description": "One or more scouting entries uploaded by a scouter",
  "type": "object",
  "properties": {
    "title": {
      "description": "The table to insert the request into",
      "type": "string",
      "enum": [
        "pits",
        "matches",
        "ranking"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "title": {
            "type": "string",
            "const": "pits"
          }
        },
        "required": [
          "title"
        ]
      },
      "then": {
        "properties": {
          "header": {
            "description": "The headers of the columns of the scouting entries",
            "type": "array",
            "const": [
              "event_key",
              "team_number",
              "scouter_name",
              "prog_lang",
              "bat_brand",
              "other_brand",
              "num_bat",
              "bat_condition",
              "height",
              "hopper",
              "hopper_size",
              "spare_parts",
              "bump",
              "trench",
              "shoot_type",
              "shoot_notes",
              "climb_type",
              "climb_notes",
              "index_type",
              "index_notes",
              "feed_rate",
              "intake",
              "intake_speed",
              "pre_checklist",
              "not_breakdown",
              "components_protected",
              "breaker_cover",
              "pic_robot_full",
              "pic_drivetrain",
              "pic_intake",
              "pic_shooter",
              "pic_climber",
              "pic_electronics",
              "pic_battery",
              "pic_battery_charging",
              "pic_misc",
              "scouted_time"
            ]
          },
          "values": {
            "description": "The list of entries to be added into the database",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "array",
              "minItems": 37,
              "maxItems": 37,
              "items": {
                "type": "string"
              }
            }
          }
        },
        "required": [
          "header",
          "values"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "title": {
            "type": "string",
            "const": "matches"
          }
        },
        "required": [
          "title"
        ]
      },
      "then": {
        "properties": {
          "header": {
            "description": "The headers of the columns of the scouting entries",
            "type": "array",
            "const": [
              "event_key",
              "match_level",
              "match_number",
              "team_data",
              "scouter_name",
              "auto_cycles",
              "teleop_cycles",
              "driver_rank",
              "defense_rank",
              "comments",
              "scouted_time"
            ]
          },
          "values": {
            "description": "The list of entries to be added into the database",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "array",
              "minItems": 11,
              "maxItems": 11,
              "items": {
                "type": "string"
              }
            }
          }
        },
        "required": [
          "header",
          "values"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "title": {
            "type": "string",
            "const": "ranking"
          }
        },
        "required": [
          "title"
        ]
      },
      "then": {
        "properties": {
          "header": {
            "description": "The headers of the columns of the scouting entries",
            "type": "array",
            "const": [
              "match",
              "red",
              "blue",
              "scouted_time"
            ]
          },
          "values": {
            "description": "The list of entries to be added into the database",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "string"
              }
            }
          }
        },
        "required": [
          "header",
          "values"
        ]
      }
    }
  ],
  "required": [
    "title",
    "header",
    "values"
  ]
}